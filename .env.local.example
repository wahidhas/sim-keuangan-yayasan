# Konfigurasi Firebase Project
# Dapatkan nilai ini dari Firebase Console -> Project Settings -> General -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDemoKeyReplaceWithYourOwnKey
